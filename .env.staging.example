##############################################################################
# Staging environment template
#
# Copy to `.env.staging` (gitignored) and fill in real values:
#   cp .env.staging.example .env.staging
#
# On the staging server, this file is usually installed as `.env`.
# Locally you can run Artisan with: php artisan --env=staging …
#
# GitHub Actions deploy-staging.yml generates `.env` from STAGING_* secrets;
# keep this file as the human-readable checklist for those values.
##############################################################################

APP_NAME=SAWTEE
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://staging.sawtee.org

# Leave empty unless using a CDN (must be an absolute URL if set).
# ASSET_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sawtee_staging
DB_USERNAME=
DB_PASSWORD=

SCOUT_DRIVER=database

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inertia SSR — off on cPanel staging/production (client-only). Local Vite still supports SSR in `npm run dev`.
INERTIA_SSR_ENABLED=false

DEBUGBAR_ENABLED=false

ABUSEIP_ENABLED=true
ABUSEIP_STORAGE_COMPRESS=true
ABUSEIP_WHITELIST=

ANALYTICS_ENABLED=true
ANALYTICS_DEDUPE_MINUTES=30
ANALYTICS_HASH_SALT=

# Optional third-party frontend keys (leave blank if unused)
# VITE_DEV_ENV_ADOBE_PDF_EMBED_API=
# VITE_PROD_ENV_ADOBE_PDF_EMBED_API=
# VITE_TINYMCE_API_KEY_GOOGLE=
# NEWSLETTER_API_KEY=
# NEWSLETTER_LIST_ID=

# Substack (newsletter archive feed + embed)
SUBSTACK_PUBLICATION_URL=https://sawteenp.substack.com
# SUBSTACK_ARCHIVE_URL=
# SUBSTACK_EMBED_URL=
